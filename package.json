{
  "name": "bandcampnation-mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "expo": "~57.0.30",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.16",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "export:android": "expo export --platform android --output-dir artifacts/android",
    "export:ios": "expo export --platform ios --output-dir artifacts/ios",
    "export:web": "expo export --platform web --output-dir dist",
    "build:android:demo": "expo run:android --variant release --no-bundler",
    "build:ios:demo": "expo run:ios --configuration Release --device generic --output artifacts/ios-simulator --no-bundler",
    "eas": "npx --yes eas-cli@24.10.0"
  },
  "private": true
}
